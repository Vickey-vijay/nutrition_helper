# NutriMind AI — environment template
# Copy this file to ".env" and edit if you want to. The app runs fine with NO
# changes at all: it degrades automatically through three AI tiers.
# setup.bat creates .env from this file automatically — you do not need to
# rename or copy it by hand.

# ===========================================================================
# AI BACKEND — which tier serves guidance, recipes, goals and log summaries
# ===========================================================================
# The AI layer tries tiers in order and silently skips any that is unavailable
# (package missing, model not downloaded, no API key, call failed):
#
#   auto   (default)  local -> groq -> rules     recommended
#   local             local -> rules             fully offline; never calls out
#   groq              groq  -> rules             cloud only (mid-sem behaviour)
#   rules             rules only                 no LLM at all, instant, free
#
# Tier 1 LOCAL : 4-bit quantised GGUF model on your own CPU. Free, private,
#                works offline. Needs llama-cpp-python + the downloaded model.
# Tier 2 GROQ  : free-tier cloud Llama 3.x. Needs GROQ_API_KEY and internet.
# Tier 3 RULES : deterministic built-in generator. Always works, no setup.
NUTRIMIND_AI_BACKEND=auto

# ===========================================================================
# TIER 1 — Local quantised model
# ===========================================================================
# setup.bat downloads this automatically after installing dependencies. To do
# it by hand later:  python -m app.setup_model
# To check what would be used without downloading:  python -m app.setup_model --check

# Where GGUF weights are stored (relative paths are resolved from the project
# root). Roughly 4.4 GB is needed for the default 7B model.
LOCAL_MODEL_DIR=models

# Repo/file to download. Leave BOTH blank to let setup_model.py choose based on
# how much RAM this machine has (see LOCAL_MODEL_MIN_RAM_GB below).
#   7B  default : TheBloke/Mistral-7B-Instruct-v0.2-GGUF
#                 mistral-7b-instruct-v0.2.Q4_K_M.gguf        (~4.4 GB)
#   3B  low-RAM : microsoft/Phi-3-mini-4k-instruct-gguf
#                 Phi-3-mini-4k-instruct-q4.gguf              (~2.4 GB)
LOCAL_MODEL_REPO=
LOCAL_MODEL_FILE=

# Machines with LESS physical RAM than this automatically get the smaller 3B
# model instead of the 7B one. Raise it if your laptop struggles.
LOCAL_MODEL_MIN_RAM_GB=8

# Overrides for the automatic low-RAM choice (leave blank for the defaults).
LOCAL_MODEL_REPO_SMALL=
LOCAL_MODEL_FILE_SMALL=

# Point straight at a .gguf file, bypassing all of the above. Use this after
# running  python -m app.quantize_model  to load your own quantised build.
LOCAL_MODEL_PATH=

# Runtime tuning for llama.cpp.
#   CTX        context window in tokens (larger = more RAM)
#   THREADS    CPU threads; 0 = let llama.cpp decide
#   GPU_LAYERS layers to offload to the GPU; 0 = pure CPU (safe default)
#   BATCH      prompt batch size
#   VERBOSE    1 to print llama.cpp's own loading diagnostics
LOCAL_MODEL_CTX=4096
LOCAL_MODEL_THREADS=0
LOCAL_MODEL_GPU_LAYERS=0
LOCAL_MODEL_BATCH=512
LOCAL_MODEL_VERBOSE=0

# Set to 1 to stop setup.bat from downloading the model (CI, metered internet).
NUTRIMIND_SKIP_MODEL_DOWNLOAD=

# Hugging Face token. Only needed for gated repos (e.g. Meta's own Llama
# weights) — the default models above are ungated and need no token.
HF_TOKEN=

# ===========================================================================
# TIER 2 — Groq cloud (fallback when no local model is installed)
# ===========================================================================
# Free tier from https://console.groq.com — optional.
GROQ_API_KEY=

# Groq model for the AI layer.
#   llama-3.3-70b-versatile = best quality (free tier)
#   llama-3.1-8b-instant    = fastest, lighter
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================================================
# App
# ===========================================================================
# Secret used to sign session tokens (change for production).
NUTRIMIND_SECRET=change-me-in-production
