# NutriMind AI — environment template
# Copy this file to ".env" and fill in your key.  The app runs fine WITHOUT a key
# (it falls back to a deterministic rule-based AI), so this step is optional.
# setup.bat creates .env from this file automatically — you do not need to
# rename or copy it by hand.

# Groq API key — free tier from https://console.groq.com
GROQ_API_KEY=

# Groq model for the AI layer.
#   llama-3.3-70b-versatile = best quality (free tier)
#   llama-3.1-8b-instant    = fastest, lighter
GROQ_MODEL=llama-3.3-70b-versatile
